{
  "manifest_version": 3,
  "name": "Inkflip: Dark Mode for Images",
  "short_name": "Inkflip",
  "version": "0.2.0",
  "description": "Turns white-background diagrams, charts and logos dark so they match dark mode. Built to run alongside Dark Reader.",
  "homepage_url": "https://inkflip.r-q.name",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Inkflip",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["defaults.js", "classifier.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": ["storage", "contextMenus", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "toggle-site": {
      "suggested_key": { "default": "Alt+Shift+I" },
      "description": "Turn Inkflip on or off for this site"
    }
  },
  "minimum_chrome_version": "116"
}
