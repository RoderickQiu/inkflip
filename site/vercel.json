{
  "installCommand": "cd .. && npm ci",
  "buildCommand": "cd .. && node scripts/package.mjs --site",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/download/inkflip-:version.zip", "destination": "/download/inkflip.zip", "permanent": false }
  ],
  "headers": [
    {
      "source": "/download/(.*)",
      "headers": [{ "key": "Content-Disposition", "value": "attachment" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
